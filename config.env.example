# Anton OCR — configurazione
# Copia questo file in `config.env` e adattalo. `config.env` è ignorato da git.

# --- Percorsi (default: ~/.anton-ocr/) ---
INPUT_DIR=~/.anton-ocr/input
OUTPUT_DIR=~/.anton-ocr/output
ARCHIVE_DIR=~/.anton-ocr/elaborati
VAULT_DIR=~/.anton-ocr/vault

# --- Modello OCR ---
# Backend Ollama (NVIDIA / CPU)
MODEL=glm-ocr:latest
OLLAMA_HOST=http://localhost:11434
NUM_CTX=16384

# Backend MLX (Apple Silicon) — modello Hugging Face
MLX_MODEL=mlx-community/GLM-OCR-8bit

# --- Rendering PDF ---
# 150 = veloce (consigliato), 200 = qualità superiore
DPI=150

# --- Tiering ---
# Pagine con meno caratteri nativi di questa soglia vanno al modello vision
TEXT_THRESHOLD=50

# --- Prestazioni ---
OCR_CONCURRENCY=3
CHUNK_SIZE=10

# --- Memoria ---
# Secondi di inattività prima di scaricare il modello dalla VRAM
IDLE_VRAM_TIMEOUT=300

# --- Privacy ---
# File di policy che governa rilevamento, redazione e blocco
POLICY_FILE=policy.yaml
# Se true, il processo rifiuta di partire se i modelli non sono già in cache
# e non effettua alcuna chiamata di rete durante l'elaborazione.
SEALED=true
