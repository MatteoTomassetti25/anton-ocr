[Unit]
Description=Anton OCR Daemon - PDF to Markdown converter
After=network.target

[Service]
Type=simple
ExecStart=__VENV_DIR__/bin/python -u __REPO_DIR__/ocr_daemon.py
WorkingDirectory=__REPO_DIR__
Restart=on-failure
RestartSec=5
StandardOutput=append:__REPO_DIR__/logs/daemon.log
StandardError=append:__REPO_DIR__/logs/daemon.err
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
