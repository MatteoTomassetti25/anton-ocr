# Anton OCR Daemon v3 - Configuration

# --- Paths ---
INPUT_DIR=/Users/cmdhro/Matteo/LettorePdf/input
OUTPUT_DIR=/Users/cmdhro/Matteo/wikiAnton/Università
ARCHIVE_DIR=/Users/cmdhro/Matteo/LettorePdf/elaborati

# --- Ollama ---
MODEL=glm-ocr:latest
OLLAMA_HOST=http://localhost:11434
NUM_CTX=16384

# --- PDF Rendering ---
# 150 = fast (recommended), 200 = higher quality
DPI=150

# --- Tiering ---
# Pages with fewer chars than this go to glm-ocr vision
TEXT_THRESHOLD=50

# --- Performance ---
# Max concurrent OCR requests (increase on NVIDIA multi-GPU, keep 3 on Apple Silicon)
OCR_CONCURRENCY=3
# Pages processed per chunk (balances RAM usage vs overhead)
CHUNK_SIZE=10

# --- VRAM Management ---
# Seconds of idle queue before unloading model from VRAM (300 = 5 min)
IDLE_VRAM_TIMEOUT=300
