# Anton OCR Daemon - Configuration
# Edit this file and re-run install.sh to apply changes.

# --- Paths ---
# Directory where you drop PDF files to be processed
INPUT_DIR=~/anton-ocr/input

# Directory where Markdown files will be saved (e.g. your Obsidian vault)
OUTPUT_DIR=~/anton-ocr/output

# Directory where processed PDFs are archived
ARCHIVE_DIR=~/anton-ocr/elaborati

# --- Ollama Settings ---
# Ollama model to use for OCR
MODEL=glm-ocr:latest

# Ollama API host
OLLAMA_HOST=http://localhost:11434

# Context window size - MUST be >= 16384 for glm-ocr to process images
NUM_CTX=16384

# --- PDF Settings ---
# Resolution in DPI for PDF-to-image conversion (higher = better quality, slower)
# Recommended: 150 (fast) or 200 (quality)
DPI=200

# Estimated seconds per page (used for ETA notifications)
SECS_PER_PAGE=22
